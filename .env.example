NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_NAME=figma-gateway
APP_VERSION=0.1.0
FIGMA_TOKEN=replace-with-figma-token
FIGMA_API_BASE_URL=https://api.figma.com
FIGMA_TIMEOUT_MS=10000
FIGMA_MAX_RETRIES=2
CACHE_TTL_FILES_MS=300000
CACHE_TTL_NODES_MS=300000
CACHE_TTL_STYLES_MS=300000
CACHE_TTL_COMPONENTS_MS=300000
CACHE_TTL_COMPONENT_SETS_MS=300000
CACHE_TTL_VARIABLES_MS=300000
CACHE_TTL_RENDER_LINKS_MS=60000
ENABLE_WRITE_ACTIONS=false
WRITE_ALLOWED_OPERATIONS=create-frame,update-text,create-section,duplicate-block,apply-style-from-alias
API_BEARER_TOKEN=change-me
CORS_ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
SQLITE_DB_PATH=/home/figma-gateway.vazovski.art/data/figma-gateway.sqlite
ALIAS_REGISTRY_SEED_ON_STARTUP=false
